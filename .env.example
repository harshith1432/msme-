# Production Environment Configuration Template
# Copy to .env.local for local overrides or configure in production orchestrator/secrets manager.

FLASK_ENV=production
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
PORT=5000

# Database Configuration (PostgreSQL with connection pooling)
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/msme
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Redis & Background Workers (Celery)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Object Storage Backend: 'local' (development/testing) or 's3' (production AWS S3 / MinIO / Cloudflare R2)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_ACCESS_KEY=your-iam-access-key-id
S3_SECRET_KEY=your-iam-secret-access-key
S3_BUCKET_PRIVATE=msme-private-documents
S3_BUCKET_KNOWLEDGE=msme-knowledge-sources
S3_REGION=ap-south-1

# External APIs (Optional)
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Limits & Uploads
MAX_CONTENT_LENGTH=16777216

# Hugging Face Inference Providers (RAG LLM Layer)
HF_TOKEN=your_hugging_face_token
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_PROVIDER=
HF_TIMEOUT_SECONDS=20
HF_MAX_RETRIES=2
HF_MAX_NEW_TOKENS=512

# RAG Knowledge-Base Enforcer
RAG_REFUSAL_MESSAGE="I can only answer questions supported by the information available in my authorized knowledge base. Please ask a question related to the available documents."
RAG_RELEVANCE_THRESHOLD=0.25

